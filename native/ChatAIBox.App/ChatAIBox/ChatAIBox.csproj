<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.26100</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject><UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>

    <!-- Display name -->
    <ApplicationTitle>ChatAIBox</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>app.chataibox.mobile</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>0.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>10</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>ChatAIBox</ApplicationPublisher>
    <!-- Package Description -->
    <Description>DeepSeek chat with encrypted device synchronization</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Skia;
    </UnoFeatures>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAppChecks)' == 'true'"><DefineConstants>$(DefineConstants);APP_CHECKS</DefineConstants></PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><RuntimeIdentifiers>win-x64</RuntimeIdentifiers><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion><UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier><UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier><RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers><AndroidPackageFormat>apk</AndroidPackageFormat><AndroidLinkMode>SdkOnly</AndroidLinkMode><AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods><_AndroidLinkAssembliesReadSymbols Condition="'$(Configuration)' == 'Release'">false</_AndroidLinkAssembliesReadSymbols><EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk><AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../ChatAIBox.Core/ChatAIBox.Core.csproj" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained"/></ItemGroup>
  <ItemGroup><ProjectReference Include="../../ChatAIBox.Edge/ChatAIBox.Edge.csproj" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained"/><PackageReference Include="Markdig"/><PackageReference Include="SkiaSharp"/></ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"><Content Include="../../../desktop/native/bin/win32-x64/backdrop.dll" Link="backdrop.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><PackageReference Include="System.Security.Cryptography.ProtectedData"/><PackageReference Include="SkiaSharp.NativeAssets.Win32"/></ItemGroup>
</Project>
