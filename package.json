{
  "name": "chatai-box",
  "version": "0.3.0",
  "private": true,
  "description": "DeepSeek chat with encrypted device synchronization",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/licenses.cjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/package-win.cjs",
    "android:sync": "npm run build && cap sync android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "https-proxy-agent": "^9.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "undici": "^7.16.0",
    "unified": "^11.0.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "app.chataibox.desktop",
    "productName": "ChatAIBox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "artifactName": "ChatAIBox-${version}-Windows-x64.zip"
    }
  }
}
